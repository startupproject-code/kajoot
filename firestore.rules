rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Global Hardened Primitives
    // =========================================================================
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidRoomCode(code) {
      return code is string && code.size() == 4 && code.matches('^[0-9]{4}$');
    }

    function isValidAnswerId(answerId) {
      return answerId is string && answerId.size() >= 3 && answerId.size() <= 140 && answerId.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidAvatar(avatarId) {
      return avatarId is string && avatarId.size() >= 2 && avatarId.size() <= 20 && avatarId in [
        'cat', 'chicken', 'cow', 'deer', 'dog', 'crocodile', 'elephant',
        'fox', 'giraffe', 'hippo', 'panda', 'penguin', 'pig', 'polar',
        'otter', 'frog', 'lion', 'snake', 'tiger'
      ];
    }

    function isValidPhase(phase) {
      return phase is string && phase.size() <= 20 && phase in ['LOBBY', 'QUESTION', 'REVEAL', 'LEADERBOARD', 'ENDED'];
    }

    // =========================================================================
    // Entity Validation Blueprints
    // =========================================================================
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'photoUrl', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == userId && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 512))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSavedQuiz(data, userId, quizId) {
      return data.keys().hasAll(['id', 'ownerUid', 'title', 'description', 'questions', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerUid', 'title', 'description', 'coverImageUrl', 'questions', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id == quizId
        && data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 && data.ownerUid == userId && data.ownerUid == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.description is string && data.description.size() <= 300
        && (!('coverImageUrl' in data) || (data.coverImageUrl is string && data.coverImageUrl.size() <= 700000))
        && data.questions is list && data.questions.size() >= 1 && data.questions.size() <= 100
        && data.questions[0] is map
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPublicQuestion(q, phase) {
      return q is map
        && q.keys().hasAll(['id', 'text', 'options', 'timeLimitSec'])
        && q.keys().hasOnly(['id', 'text', 'options', 'timeLimitSec', 'imageUrl', 'videoUrl', 'correctIndex'])
        && q.id is string && q.id.size() >= 1 && q.id.size() <= 128
        && q.text is string && q.text.size() >= 1 && q.text.size() <= 500
        && q.options is list && q.options.size() == 4
        && q.options[0] is string && q.options[0].size() >= 1 && q.options[0].size() <= 200
        && q.options[1] is string && q.options[1].size() >= 1 && q.options[1].size() <= 200
        && q.options[2] is string && q.options[2].size() >= 1 && q.options[2].size() <= 200
        && q.options[3] is string && q.options[3].size() >= 1 && q.options[3].size() <= 200
        && q.timeLimitSec is number && q.timeLimitSec >= 5 && q.timeLimitSec <= 180
        && (!('imageUrl' in q) || (q.imageUrl is string && q.imageUrl.size() <= 700000))
        && (!('videoUrl' in q) || (q.videoUrl is string && q.videoUrl.size() <= 2048))
        && (phase != 'QUESTION' ? (!('correctIndex' in q) || (q.correctIndex is int && q.correctIndex >= 0 && q.correctIndex <= 3)) : !('correctIndex' in q));
    }

    function isValidRoom(data, roomCode) {
      return data.keys().hasAll([
          'code', 'hostUid', 'quizTitle', 'phase', 'currentQuestionIndex',
          'totalQuestions', 'currentQuestion', 'questionStartedAt', 'questionEndsAt',
          'answeredCount', 'totalPlayers', 'maxPlayers', 'answerCounts', 'leaderboard',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'code', 'hostUid', 'quizTitle', 'phase', 'currentQuestionIndex',
          'totalQuestions', 'currentQuestion', 'questionStartedAt', 'questionEndsAt',
          'answeredCount', 'totalPlayers', 'maxPlayers', 'answerCounts', 'leaderboard',
          'createdAt', 'updatedAt'
        ])
        && data.code is string && data.code.size() == 4 && data.code == roomCode
        && data.hostUid is string && data.hostUid.size() >= 1 && data.hostUid.size() <= 128
        && data.quizTitle is string && data.quizTitle.size() >= 1 && data.quizTitle.size() <= 120
        && isValidPhase(data.phase)
        && data.currentQuestionIndex is int && data.currentQuestionIndex >= -1 && data.currentQuestionIndex <= 100
        && data.totalQuestions is int && data.totalQuestions >= 1 && data.totalQuestions <= 100
        && (data.currentQuestion == null || isValidPublicQuestion(data.currentQuestion, data.phase))
        && (data.questionStartedAt == null || data.questionStartedAt is number)
        && (data.questionEndsAt == null || data.questionEndsAt is number)
        && data.answeredCount is int && data.answeredCount >= 0 && data.answeredCount <= 200
        && data.totalPlayers is int && data.totalPlayers >= 0 && data.totalPlayers <= 200
        && data.maxPlayers is int && data.maxPlayers == 200
        && data.answerCounts is list && data.answerCounts.size() == 4
        && data.answerCounts[0] is int && data.answerCounts[0] >= 0
        && data.answerCounts[1] is int && data.answerCounts[1] >= 0
        && data.answerCounts[2] is int && data.answerCounts[2] >= 0
        && data.answerCounts[3] is int && data.answerCounts[3] >= 0
        && data.leaderboard is list && data.leaderboard.size() <= 200
        && (data.leaderboard.size() == 0 || (
          data.leaderboard[0] is map
          && data.leaderboard[0].keys().hasAll(['id', 'name', 'avatarId', 'score', 'rank'])
          && data.leaderboard[0].name is string && data.leaderboard[0].name.size() <= 24
          && data.leaderboard[0].score is int && data.leaderboard[0].score >= 0
        ))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRoomHostData(data, roomCode) {
      return data.keys().hasAll(['roomCode', 'hostUid', 'quiz', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['roomCode', 'hostUid', 'quiz', 'createdAt', 'updatedAt'])
        && data.roomCode is string && data.roomCode.size() == 4 && data.roomCode == roomCode
        && data.hostUid is string && data.hostUid.size() >= 1 && data.hostUid.size() <= 128 && data.hostUid == request.auth.uid
        && data.quiz is map && data.quiz.keys().hasAll(['id', 'title', 'questions'])
        && data.quiz.questions is list && data.quiz.questions.size() >= 1 && data.quiz.questions.size() <= 100
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRoomPlayer(data, roomCode, playerId) {
      return data.keys().hasAll([
          'id', 'uid', 'roomCode', 'hostUid', 'name', 'avatarId',
          'score', 'streak', 'bestStreak', 'correctCount', 'answeredCount',
          'lastPoints', 'lastCorrect', 'lastChoice', 'rank', 'connected',
          'joinedAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'uid', 'roomCode', 'hostUid', 'name', 'avatarId',
          'score', 'streak', 'bestStreak', 'correctCount', 'answeredCount',
          'lastPoints', 'lastCorrect', 'lastChoice', 'rank', 'connected',
          'joinedAt', 'updatedAt'
        ])
        && data.id is string && data.id.size() >= 12 && data.id.size() <= 128 && data.id == playerId
        && data.uid is string && data.uid.size() >= 12 && data.uid.size() <= 128 && data.uid == playerId
        && data.roomCode is string && data.roomCode.size() == 4 && data.roomCode == roomCode
        && data.hostUid is string && data.hostUid.size() >= 1 && data.hostUid.size() <= 128
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 24
        && isValidAvatar(data.avatarId)
        && data.score is int && data.score >= 0
        && data.streak is int && data.streak >= 0
        && data.bestStreak is int && data.bestStreak >= 0
        && data.correctCount is int && data.correctCount >= 0
        && data.answeredCount is int && data.answeredCount >= 0
        && data.lastPoints is int && data.lastPoints >= 0
        && (data.lastCorrect == null || data.lastCorrect is bool)
        && (data.lastChoice == null || (data.lastChoice is int && data.lastChoice >= 0 && data.lastChoice <= 3))
        && data.rank is int && data.rank >= 1 && data.rank <= 200
        && data.connected is bool
        && data.joinedAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRoomAnswer(data, roomCode, answerId) {
      return data.keys().hasAll(['id', 'roomCode', 'hostUid', 'playerUid', 'questionIndex', 'choice', 'submittedAt'])
        && data.keys().hasOnly(['id', 'roomCode', 'hostUid', 'playerUid', 'questionIndex', 'choice', 'submittedAt'])
        && data.id is string && data.id.size() >= 14 && data.id.size() <= 140 && data.id == answerId
        && data.roomCode is string && data.roomCode.size() == 4 && data.roomCode == roomCode
        && data.hostUid is string && data.hostUid.size() >= 1 && data.hostUid.size() <= 128
        && data.playerUid is string && data.playerUid.size() >= 12 && data.playerUid.size() <= 128
        && data.questionIndex is int && data.questionIndex >= 0 && data.questionIndex <= 100
        && data.choice is int && data.choice >= 0 && data.choice <= 3
        && data.submittedAt is timestamp
        && answerId == (string(data.questionIndex) + '_' + data.playerUid);
    }

    // =========================================================================
    // /users/{userId} — Isolated Private Profile (PII)
    // =========================================================================
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoUrl', 'updatedAt']);
      allow delete: if false;

      // /users/{userId}/quizzes/{quizId} — Saved Moderator Quiz Sets
      match /quizzes/{quizId} {
        allow get: if isValidId(userId) && isValidId(quizId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.ownerUid == request.auth.uid;
        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(quizId)
          && isOwner(userId)
          && isValidSavedQuiz(incoming(), userId, quizId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(quizId)
          && isOwner(userId)
          && isValidSavedQuiz(incoming(), userId, quizId)
          && incoming().id == existing().id
          && incoming().ownerUid == existing().ownerUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'coverImageUrl', 'questions', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(quizId) && isOwner(userId);
      }
    }

    // =========================================================================
    // /rooms/{roomCode} — Live Quiz Room (Zero PII, Guest QR Join Allowed)
    // =========================================================================
    match /rooms/{roomCode} {
      allow get: if isValidRoomCode(roomCode);
      allow list: if isVerifiedUser() && resource.data.hostUid == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidRoomCode(roomCode)
        && isValidRoom(incoming(), roomCode)
        && incoming().hostUid == request.auth.uid
        && incoming().phase == 'LOBBY'
        && incoming().currentQuestionIndex == -1
        && incoming().currentQuestion == null
        && incoming().totalPlayers == 0
        && incoming().answeredCount == 0
        && incoming().leaderboard.size() == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidRoomCode(roomCode)
        && isValidRoom(incoming(), roomCode)
        && existing().hostUid == request.auth.uid
        && existing().phase != 'ENDED'
        && incoming().code == existing().code
        && incoming().hostUid == existing().hostUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (incoming().phase == existing().phase && incoming().diff(existing()).affectedKeys().hasOnly(['answeredCount', 'totalPlayers', 'answerCounts', 'leaderboard', 'updatedAt'])) ||
          (incoming().phase == 'QUESTION' && incoming().diff(existing()).affectedKeys().hasOnly(['phase', 'currentQuestionIndex', 'currentQuestion', 'questionStartedAt', 'questionEndsAt', 'answeredCount', 'totalPlayers', 'answerCounts', 'leaderboard', 'updatedAt'])) ||
          (incoming().phase == 'REVEAL' && existing().phase == 'QUESTION' && incoming().diff(existing()).affectedKeys().hasOnly(['phase', 'currentQuestion', 'answeredCount', 'totalPlayers', 'answerCounts', 'leaderboard', 'updatedAt'])) ||
          ((incoming().phase == 'LEADERBOARD' || incoming().phase == 'ENDED') && incoming().diff(existing()).affectedKeys().hasOnly(['phase', 'currentQuestion', 'questionStartedAt', 'questionEndsAt', 'answeredCount', 'totalPlayers', 'answerCounts', 'leaderboard', 'updatedAt']))
        );

      allow delete: if isVerifiedUser()
        && isValidRoomCode(roomCode)
        && existing().hostUid == request.auth.uid;

      // /rooms/{roomCode}/hostData/{docId} — Host-only Private Answer Keys
      match /hostData/{docId} {
        allow get: if isVerifiedUser()
          && isValidRoomCode(roomCode)
          && isValidId(docId)
          && existing().hostUid == request.auth.uid;
        allow list: if isVerifiedUser() && resource.data.hostUid == request.auth.uid;
        allow create: if isVerifiedUser()
          && isValidRoomCode(roomCode)
          && isValidId(docId)
          && docId == 'quiz'
          && isValidRoomHostData(incoming(), roomCode)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && get(/databases/$(database)/documents/rooms/$(roomCode)).data.hostUid == request.auth.uid;
        allow update: if isVerifiedUser()
          && isValidRoomCode(roomCode)
          && isValidId(docId)
          && isValidRoomHostData(incoming(), roomCode)
          && existing().hostUid == request.auth.uid
          && incoming().roomCode == existing().roomCode
          && incoming().hostUid == existing().hostUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['quiz', 'updatedAt']);
        allow delete: if isVerifiedUser()
          && isValidRoomCode(roomCode)
          && isValidId(docId)
          && existing().hostUid == request.auth.uid;
      }

      // /rooms/{roomCode}/players/{playerId} — Guest QR Players (Up to 200, Zero PII)
      match /players/{playerId} {
        allow get: if isValidRoomCode(roomCode) && isValidId(playerId);
        allow list: if isVerifiedUser() && resource.data.hostUid == request.auth.uid;

        allow create: if isValidRoomCode(roomCode)
          && isValidId(playerId)
          && isValidRoomPlayer(incoming(), roomCode, playerId)
          && incoming().score == 0
          && incoming().streak == 0
          && incoming().bestStreak == 0
          && incoming().correctCount == 0
          && incoming().answeredCount == 0
          && incoming().lastPoints == 0
          && incoming().lastCorrect == null
          && incoming().lastChoice == null
          && incoming().rank == 1
          && incoming().joinedAt == request.time
          && incoming().updatedAt == request.time
          && get(/databases/$(database)/documents/rooms/$(roomCode)).data.phase != 'ENDED'
          && get(/databases/$(database)/documents/rooms/$(roomCode)).data.totalPlayers < 200
          && incoming().hostUid == get(/databases/$(database)/documents/rooms/$(roomCode)).data.hostUid;

        allow update: if isValidRoomCode(roomCode)
          && isValidId(playerId)
          && isValidRoomPlayer(incoming(), roomCode, playerId)
          && incoming().id == existing().id
          && incoming().uid == existing().uid
          && incoming().roomCode == existing().roomCode
          && incoming().hostUid == existing().hostUid
          && incoming().joinedAt == existing().joinedAt
          && incoming().updatedAt == request.time
          && get(/databases/$(database)/documents/rooms/$(roomCode)).data.phase != 'ENDED'
          && (
            (isVerifiedUser()
              && existing().hostUid == request.auth.uid
              && incoming().diff(existing()).affectedKeys().hasOnly(['score', 'streak', 'bestStreak', 'correctCount', 'answeredCount', 'lastPoints', 'lastCorrect', 'lastChoice', 'rank', 'updatedAt'])) ||
            (incoming().diff(existing()).affectedKeys().hasOnly(['name', 'avatarId', 'connected', 'updatedAt']))
          );

        allow delete: if isVerifiedUser()
          && isValidRoomCode(roomCode)
          && isValidId(playerId)
          && existing().hostUid == request.auth.uid;
      }

      // /rooms/{roomCode}/answers/{answerId} — Immutable Guest Answer Submissions
      match /answers/{answerId} {
        allow get: if isValidRoomCode(roomCode) && isValidAnswerId(answerId);
        allow list: if isVerifiedUser() && resource.data.hostUid == request.auth.uid;

        allow create: if isValidRoomCode(roomCode)
          && isValidAnswerId(answerId)
          && isValidRoomAnswer(incoming(), roomCode, answerId)
          && incoming().submittedAt == request.time
          && exists(/databases/$(database)/documents/rooms/$(roomCode)/players/$(incoming().playerUid))
          && get(/databases/$(database)/documents/rooms/$(roomCode)).data.phase == 'QUESTION'
          && get(/databases/$(database)/documents/rooms/$(roomCode)).data.currentQuestionIndex == incoming().questionIndex
          && incoming().hostUid == get(/databases/$(database)/documents/rooms/$(roomCode)).data.hostUid;

        allow update: if false;

        allow delete: if isVerifiedUser()
          && isValidRoomCode(roomCode)
          && isValidAnswerId(answerId)
          && existing().hostUid == request.auth.uid;
      }
    }
  }
}
